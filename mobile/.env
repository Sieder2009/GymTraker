# Ironpeak Fitness — runtime configuration.
# No secrets in here (this repo is public and this file IS committed) —
# just the values that would otherwise be hardcoded: which GitHub repo the
# exercise database and update checks come from, and how often to check.
# See lib/config/app_config.dart for how these are read.

GITHUB_OWNER=Sieder2009
GITHUB_REPO=GymTraker
GITHUB_BRANCH=master

# Raw file the exercise picker downloads at runtime (falls back to the
# bundled assets/exercises.json copy if this can't be reached).
EXERCISE_DATABASE_PATH=mobile/assets/exercises.json

# How often the app checks GitHub Releases for a newer version, and
# whether that check runs at all.
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_HOURS=6

# Contact shown on the Settings screen's help card.
SUPPORT_EMAIL=thomasjohann09@gmail.com
SUPPORT_PHONE=3914126668
