migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Generated localizations (regenerated from lib/l10n/*.arb via `generate: true`)
/lib/l10n/app_localizations*.dart
/untranslated.txt

# Flutter/Dart/Pub related
**/doc/api/
# Generated fresh every CI run (flutter create --platforms=ios/macos), same
# as android/ used to be before Health Connect needed persistent manifest
# changes — see .github/workflows/ios.yml and macos.yml.
/ios/
/macos/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# tool/seed_demo_data.dart's local SQLite database -- the real app never
# writes here (StorageService uses the OS's per-app documents directory,
# outside the repo), but the dev seed script's own path resolution used to
# fall back to the current working directory when run from mobile/ on
# macOS/Linux, landing it right here. Keeping this ignored is a safety net
# even after fixing that fallback.
/ironpeak.db
